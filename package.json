{
  "name": "md-books-mcp",
  "version": "0.1.0",
  "description": "MCP server for finding books and making citations, from Open Library, Hardcover, Google Books, Library of Congress and more",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "md-books-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "csl",
    "src",
    "README.md",
    "LICENSE",
    "links.example.json",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "books",
    "bookshop",
    "citations",
    "csl",
    "google-books",
    "hardcover",
    "isbn",
    "mcp",
    "modelcontextprotocol",
    "obsidian",
    "openlibrary"
  ],
  "author": "Kim Plowright",
  "license": "MIT",
  "dependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-csl": "0.9.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "fast-xml-parser": "5.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mildlydiverting/md-books-mcp.git"
  },
  "homepage": "https://github.com/mildlydiverting/md-books-mcp#readme",
  "bugs": {
    "url": "https://github.com/mildlydiverting/md-books-mcp/issues"
  }
}
