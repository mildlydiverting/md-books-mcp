{
  "name": "md-books-mcp",
  "version": "0.1.0",
  "description": "MCP server for finding books and making citations, with pluggable data sources (Google Books first)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "md-books-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "books",
    "isbn",
    "citations",
    "google-books"
  ],
  "author": "Kim Plowright",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
