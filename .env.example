# Names only: this server does NOT read a .env file.
# Put the values in your MCP client's "env" block (see README, Setup),
# or load them from a secret store such as macOS Keychain before launching.
# Leave out any you do not need; everything here is optional except as noted.

# API keys (secrets)
GOOGLE_BOOKS_API_KEY=      # needed for Google Books
HARDCOVER_API_KEY=         # needed for Hardcover

# Polite contact address sent to free APIs (an email or URL)
OPENLIBRARY_CONTACT=
CROSSREF_CONTACT=
BOOKBRAINZ_CONTACT=
WIKIDATA_CONTACT=

# Affiliate IDs (public, but personal: keep yours out of the repo)
BOOKSHOP_AFFILIATE_ID=     # Bookshop.org (UK) ISBN links
AMAZON_ASSOCIATE_TAG=      # Amazon UK links, e.g. yourname-21

# Path to your own search-links file (default ~/.config/md-books-mcp/links.json)
MD_BOOKS_LINKS_FILE=
